.idea/
.DS_Store
Thumbs.db
*.swp
*~

# Local secrets and configuration
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx

# Logs and disposable test output
*.log
logs/
tmp/
temp/
coverage/
